diff --git a/src/Filee.Cli/EngineSetup.cs b/src/Filee.Cli/EngineSetup.cs
new file mode 100644
index 0000000..c25949a
--- /dev/null
+++ b/src/Filee.Cli/EngineSetup.cs
@@ -0,0 +1,277 @@
+// Installs the optional engines (LibreOffice, Pandoc, Ghostscript, FFmpeg, calibre) when a conversion needs one that
+// is not there, and implements "filee engines list|install|remove". The app does the same from Settings → Engines;
+// the command line has no window to ask in, so a conversion that cannot run installs the engine itself, unless
+// --no-install is given. Progress goes to the error stream, so --json output stays one clean document.
+
+using Filee.Core.Conversion;
+using Filee.Core.Formats;
+using Filee.Core.Presets;
+using Filee.Engines.Infrastructure;
+
+namespace Filee.Cli;
+
+internal sealed class EngineSetup
+{
+    private readonly CliHost _host;
+    private readonly EngineInstaller _installer;
+    private readonly TextWriter _log;
+
+    public EngineSetup(CliHost host, TextWriter log, EngineInstaller? installer = null)
+    {
+        _host = host;
+        _log = log;
+        if (installer is null)
+        {
+            // Redirects are followed by the installer itself (mirrors may use plain HTTP; every file is checked by SHA-256).
+            var http = new HttpClient(new SocketsHttpHandler { AllowAutoRedirect = false }) { Timeout = Timeout.InfiniteTimeSpan };
+            http.DefaultRequestHeaders.UserAgent.ParseAdd($"filee-cli/{Help.Version}");
+            installer = new EngineInstaller(http);
+        }
+        _installer = installer;
+    }
+
+    /// <summary>The package with this id, or null.</summary>
+    public static EnginePackage? Find(string id) =>
+        EngineDownloads.Packages.FirstOrDefault(p => string.Equals(p.Id, id, StringComparison.OrdinalIgnoreCase));
+
+    /// <summary>
+    /// Packages that would make the files convertible, in the order that adds the fewest: for each file whose route
+    /// does not exist with the engines now in place, the first not-installed package that gives it one. A route that
+    /// needs two packages (EPS → PDF → DOCX with Ghostscript and LibreOffice) is found in a second round.
+    /// </summary>
+    public IReadOnlyList<EnginePackage> Needed(IEnumerable<string> files, Preset preset)
+    {
+        var chosen = new List<EnginePackage>();
+        // A 0-byte file fails with "The file is empty" whatever engines there are, so it is no reason to download one.
+        var sources = files.Where(f => !IsEmptyFile(f)).Select(FormatRegistry.Detect).Where(f => f is not null).Select(f => f!).DistinctBy(f => f.Id).ToList();
+        if (sources.Count == 0)
+            return chosen;
+        var candidates = EngineDownloads.Packages.Where(p => EngineDownloads.CanDownload(p) && !IsAvailable(p)).ToList();
+
+        foreach (var source in sources)
+        {
+            var target = preset.TargetFormat == BuiltInData.SameAsSource ? source.Id : preset.TargetFormat;
+            if (CanConvert(source.Id, target, preset, chosen))
+                continue;
+            // One package first, then pairs (a route through PostScript and then an Office format).
+            var single = candidates.Where(p => !chosen.Contains(p)).FirstOrDefault(p => CanConvert(source.Id, target, preset, [.. chosen, p]));
+            if (single is not null)
+            {
+                chosen.Add(single);
+                continue;
+            }
+            foreach (var first in candidates.Where(p => !chosen.Contains(p)))
+            {
+                var second = candidates.Where(p => p != first && !chosen.Contains(p))
+                    .FirstOrDefault(p => CanConvert(source.Id, target, preset, [.. chosen, first, p]));
+                if (second is null)
+                    continue;
+                chosen.AddRange([first, second]);
+                break;
+            }
+        }
+        return chosen;
+    }
+
+    private static bool IsEmptyFile(string path)
+    {
+        try
+        {
+            var info = new FileInfo(path);
+            return info.Exists && info.Length == 0;
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException or NotSupportedException)
+        {
+            return false;
+        }
+    }
+
+    /// <summary>Whether a route exists when the engines in place and <paramref name="extra"/> are all there.</summary>
+    private bool CanConvert(string from, string to, Preset preset, IReadOnlyList<EnginePackage> extra)
+    {
+        var assumed = extra.SelectMany(p => p.ConverterIds).ToList();
+        var planner = assumed.Count == 0 ? _host.Catalog.CreatePlanner() : _host.Catalog.CreatePlanner(assumed);
+        if (preset.Pdf.MergeIntoSingle && to == "pdf" && FormatRegistry.FindById(from)?.Id != "pdf")
+            return planner.CanConvert(from, "pdf");
+        var frames = preset.SavesFramesOf(from);
+        var motion = preset.ExtractsMotionOf(from);
+        var live = preset.MakesLivePhotoOf(from);
+        return planner.CanConvert(from, to, frames, motion, live);
+    }
+
+    /// <summary>True when the engine is installed (Filee's copy, the user's own, or one on this computer).</summary>
+    public bool IsAvailable(EnginePackage package) =>
+        package.ConverterIds.All(id => _host.Catalog.All.Any(c => c.Id == id && _host.Catalog.StatusOf(c).IsAvailable));
+
+    /// <summary>Downloads and installs the packages one after the other, showing progress. Returns false when one failed.</summary>
+    /// <param name="explicitRequest">The user asked for these engines by name: install Filee's own copy even when the computer has one.
+    /// A conversion that needs an engine passes false and only installs what is missing altogether.</param>
+    public async Task<bool> InstallAsync(IEnumerable<EnginePackage> packages, bool quiet, CancellationToken cancellationToken, bool explicitRequest = false)
+    {
+        // Two filee-cli processes must not unpack into the same folder, so installs take turns across processes too.
+        using var gate = await InstallLock.AcquireAsync(Path.Combine(EngineEnvironment.DownloadRoot, ".install.lock"), _log, quiet, cancellationToken);
+        foreach (var package in packages)
+        {
+            // Another process may have installed it while this one waited for the lock.
+            _host.Catalog.Refresh();
+            EngineEnvironment.ForgetSystemCopies();
+            var ours = _installer.IsInstalled(package) && _installer.IsUpToDate(package);
+            if (explicitRequest ? ours : IsAvailable(package))
+            {
+                if (!quiet)
+                    _log.WriteLine($"filee: {package.Id} is already available ({(ours ? "installed by filee" : "found on this computer")}).");
+                continue;
+            }
+            if (!EngineDownloads.CanDownload(package))
+            {
+                _log.WriteLine($"filee: {EngineDownloads.UnavailableReason(package)}");
+                return false;
+            }
+            if (!quiet)
+                _log.WriteLine($"filee: installing {package.Id} ({FormatBytes(EngineDownloads.DownloadSize(package))} download, {FormatBytes(package.InstalledSize)} on disk) into {EngineEnvironment.DownloadRoot}");
+            try
+            {
+                var progress = new ProgressLine(_log, quiet);
+                await _installer.InstallAsync(package, progress, cancellationToken);
+                progress.Finish();
+            }
+            catch (OperationCanceledException)
+            {
+                _log.WriteLine($"filee: installing {package.Id} was cancelled.");
+                return false;
+            }
+            catch (Exception ex) when (ex is HttpRequestException or IOException or InvalidDataException or InvalidOperationException
+                                           or PlatformNotSupportedException or NotSupportedException or UnauthorizedAccessException)
+            {
+                _log.WriteLine($"filee: could not install {package.Id}: {ex.Message}");
+                return false;
+            }
+            _host.Catalog.Refresh();
+            EngineEnvironment.ForgetSystemCopies();
+            if (!IsAvailable(package))
+            {
+                _log.WriteLine($"filee: {package.Id} was installed but does not start on this computer.");
+                return false;
+            }
+            if (!quiet)
+                _log.WriteLine($"filee: {package.Id} is installed.");
+        }
+        return true;
+    }
+
+    /// <summary>Removes Filee's downloaded copy of the package. Returns false when there was none.</summary>
+    public bool Remove(EnginePackage package)
+    {
+        if (!_installer.IsInstalled(package))
+            return false;
+        _installer.Uninstall(package);
+        _host.Catalog.Refresh();
+        return true;
+    }
+
+    /// <summary>"id  status  size  what it is for" for every package, for "filee engines list".</summary>
+    public void List(TextWriter output)
+    {
+        output.WriteLine($"{"ENGINE",-12} {"STATUS",-26} {"DOWNLOAD",-10} USED FOR");
+        foreach (var package in EngineDownloads.Packages)
+        {
+            output.WriteLine($"{package.Id,-12} {Status(package),-26} {(EngineDownloads.CanDownload(package) ? FormatBytes(EngineDownloads.DownloadSize(package)) : "-"),-10} {Purpose(package.Id)}");
+        }
+        output.WriteLine();
+        output.WriteLine($"Installed into {EngineEnvironment.DownloadRoot}. A conversion that needs one installs it by itself (--no-install to stop that).");
+        output.WriteLine("rhwp and 7-Zip are part of filee-cli and need no download.");
+    }
+
+    private string Status(EnginePackage package)
+    {
+        if (_installer.IsInstalled(package) && IsAvailable(package))
+            return _installer.IsUpToDate(package) ? "installed" : "installed (older version)";
+        if (IsAvailable(package))
+            return "found on this computer";
+        return EngineDownloads.CanDownload(package) ? "not installed" : "not available here";
+    }
+
+    internal static string Purpose(string id) => id switch
+    {
+        "libreoffice" => "DOC, PPT, RTF, OpenDocument and other older or rare office formats",
+        "pandoc" => "Markdown, LaTeX, Org, AsciiDoc and other markup; Markdown to slides",
+        "ghostscript" => "EPS and PostScript",
+        "ffmpeg" => "video and audio",
+        "calibre" => "Kindle (MOBI, AZW3) and rare e-book formats",
+        _ => "",
+    };
+
+    internal static string FormatBytes(long bytes) => bytes >= 1_000_000_000
+        ? $"{bytes / 1_000_000_000.0:0.0} GB"
+        : $"{Math.Max(1, bytes / 1_000_000)} MB";
+
+    /// <summary>One line of progress that redraws itself in a terminal and prints a line per step otherwise.</summary>
+    private sealed class ProgressLine(TextWriter log, bool quiet) : IProgress<EngineInstallProgress>
+    {
+        private int _lastPercent = -1;
+        private string _lastStage = "";
+        private readonly bool _terminal = !Console.IsErrorRedirected;
+        private DateTime _lastWrite = DateTime.MinValue;
+
+        public void Report(EngineInstallProgress value)
+        {
+            if (quiet)
+                return;
+            var percent = (int)(value.Fraction * 100);
+            var stage = value.Stage == EngineInstallStage.Downloading ? "downloading" : "unpacking";
+            if (_terminal)
+            {
+                if (percent == _lastPercent && stage == _lastStage || (DateTime.UtcNow - _lastWrite).TotalMilliseconds < 100 && stage == _lastStage)
+                    return;
+                log.Write($"\r  {stage} {value.ComponentId} {percent,3}%  {FormatBytes(value.BytesDone)} / {FormatBytes(value.BytesTotal)}   ");
+            }
+            else
+            {
+                // A log file or a pipe: a line at every tenth, not a hundred of them.
+                if (stage == _lastStage && percent / 10 == _lastPercent / 10)
+                    return;
+                log.WriteLine($"  {stage} {value.ComponentId} {percent}%");
+            }
+            _lastPercent = percent;
+            _lastStage = stage;
+            _lastWrite = DateTime.UtcNow;
+        }
+
+        public void Finish()
+        {
+            if (!quiet && _terminal && _lastPercent >= 0)
+                log.WriteLine();
+        }
+    }
+}
+
+/// <summary>An exclusive file lock held while engines are installed, so two processes never unpack into one folder.</summary>
+internal sealed class InstallLock : IDisposable
+{
+    private readonly FileStream _file;
+
+    private InstallLock(FileStream file) => _file = file;
+
+    public static async Task<InstallLock> AcquireAsync(string path, TextWriter log, bool quiet, CancellationToken cancellationToken)
+    {
+        Directory.CreateDirectory(Path.GetDirectoryName(path)!);
+        var told = false;
+        while (true)
+        {
+            try
+            {
+                // FileShare.None: a second process cannot open the file until the first one closes it (or exits).
+                return new InstallLock(new FileStream(path, FileMode.OpenOrCreate, FileAccess.ReadWrite, FileShare.None));
+            }
+            catch (IOException)
+            {
+                if (!told && !quiet)
+                    log.WriteLine("filee: another filee-cli is installing an engine; waiting for it.");
+                told = true;
+                await Task.Delay(500, cancellationToken);
+            }
+        }
+    }
+
+    public void Dispose() => _file.Dispose();
+}
