+    /// <summary>
+    /// Unpacks the program of a conda package built for macOS: <c>bin/&lt;program&gt;</c> (Ghostscript's gs is one
+    /// self-contained program with its resources compiled in) and the package's license files, nothing else.
+    /// </summary>
+    internal static void UnpackCondaUnix(string id, string condaFile, string target, CancellationToken cancellationToken)
+    {
+        var program = EngineEnvironment.OwnCopyPrograms.TryGetValue(id, out var programs) && programs.Length == 1
+            ? EngineEnvironment.ProgramName(programs[0])
+            : throw new NotSupportedException($"No single program is defined for {id}.");
+        using var zip = ZipFile.OpenRead(condaFile);
+        Directory.CreateDirectory(target);
+        var root = Path.GetFullPath(target) + Path.DirectorySeparatorChar;
+        var found = false;
+        foreach (var payload in zip.Entries.Where(e => e.FullName.EndsWith(".tar.zst", StringComparison.Ordinal)
+                     && (e.FullName.StartsWith("pkg-", StringComparison.Ordinal) || e.FullName.StartsWith("info-", StringComparison.Ordinal))))
+        {
+            var isPackage = payload.FullName.StartsWith("pkg-", StringComparison.Ordinal);
+            using var zstd = new DecompressionStream(payload.Open(), leaveOpen: false);
+            using var tar = new TarReader(zstd);
+            while (tar.GetNextEntry() is { } entry)
+            {
+                cancellationToken.ThrowIfCancellationRequested();
+                if (entry.EntryType is not (TarEntryType.RegularFile or TarEntryType.V7RegularFile))
+                    continue;
+                var name = entry.Name.Replace('\\', '/');
+                string? relative = null;
+                if (isPackage && name == "bin/" + program)
+                {
+                    relative = program;
+                    found = true;
+                }
+                else if (!isPackage && name.StartsWith("info/licenses/", StringComparison.Ordinal))
+                    relative = "licenses/" + name["info/licenses/".Length..];
+                if (relative is null)
+                    continue;
+                var path = Path.GetFullPath(Path.Combine(target, relative));
+                if (!path.StartsWith(root, StringComparison.Ordinal))
+                    throw new InvalidDataException($"Unsafe path in conda package: {entry.Name}");
+                Directory.CreateDirectory(Path.GetDirectoryName(path)!);
+                entry.ExtractToFile(path, overwrite: true);
+            }
+        }
+        if (!found)
+            throw new InvalidDataException($"The conda package has no bin/{program}.");
+    }
+
+    /// <summary>
+    /// Unpacks zips that each hold one program (FFmpeg and ffprobe come as separate zips of the same build) into one
+    /// folder. The programs are not touched otherwise, so a signature their maker put on them stays valid.
+    /// </summary>
+    internal static void UnpackZipPrograms(string id, IReadOnlyList<string> zips, string target)
+    {
+        Directory.CreateDirectory(target);
+        var root = Path.GetFullPath(target) + Path.DirectorySeparatorChar;
+        foreach (var file in zips)
+        {
+            using var zip = ZipFile.OpenRead(file);
+            foreach (var entry in zip.Entries.Where(e => e.Length > 0))
+            {
+                var path = Path.GetFullPath(Path.Combine(target, entry.FullName));
+                if (!path.StartsWith(root, StringComparison.Ordinal) || entry.FullName.Contains('/'))
+                    throw new InvalidDataException($"Unexpected entry in the {id} download: {entry.FullName}");
+                entry.ExtractToFile(path, overwrite: true);
+            }
+        }
+    }
